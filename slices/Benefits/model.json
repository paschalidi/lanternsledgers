              "description": {
                "type": "StructuredText",
                "config": { "label": "Description", "multi": "paragraph,strong,em" }
              },
              "icon": {
                "type": "Select",
                "config": {
                  "label": "Icon",
                  "options": ["check", "star", "heart", "bolt", "shield", "rocket", "code", "palette", "camera", "chart"]
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
