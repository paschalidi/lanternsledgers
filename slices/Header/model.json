{
  "description": "Site header with logo, navigation links, and CTA button",
  "id": "header",
  "name": "Header",
  "type": "SharedSlice",
  "variations": [
    {
      "description": "Standard header with logo, nav, and CTA",
      "docURL": "",
      "id": "default",
      "imageUrl": "",
      "items": {},
      "name": "Default",
      "primary": {
        "logo_light": {
          "config": {
            "constraint": {
              "height": 68,
              "width": 210
            },
            "label": "Logo (Light Mode)"
          },
          "type": "Image"
        },
        "logo_dark": {
          "config": {
            "constraint": {
              "height": 68,
              "width": 210
            },
            "label": "Logo (Dark Mode)"
          },
          "type": "Image"
        },
        "cta_text": {
          "config": {
            "label": "CTA Text",
            "placeholder": "Let's work together"
          },
          "type": "Text"
        },
        "cta_link": {
          "config": {
            "allowTargetBlank": true,
            "allowText": true,
            "label": "CTA Link",
            "repeat": false
          },
          "type": "Link"
        },
        "nav_links": {
          "config": {
            "fields": {
              "link_text": {
                "config": {
                  "label": "Link Text",
                  "placeholder": "About"
                },
                "type": "Text"
              },
              "link": {
                "config": {
                  "allowTargetBlank": true,
                  "allowText": true,
                  "label": "Link",
                  "repeat": false
                },
                "type": "Link"
              }
            },
            "label": "Navigation Links",
            "repeat": true
          },
          "type": "Group"
        },
        "linkedin_url": {
          "config": {
            "allowTargetBlank": true,
            "label": "LinkedIn URL",
            "select": "web"
          },
          "type": "Link"
        }
      },
      "version": "initial"
    }
  ]
}